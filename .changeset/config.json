{
  "$schema": "https://unpkg.com/@changesets/config@2.3.0/schema.json",
  "changelog": ["./my-changelog-config.js", { "repo": "helvetia-design/design-system" }],
  "commit": false,
  "fixed": [["@helvetia-design/*"]],
  "ignore": ["libs-*", "storybook", "toky", "integration-react", "integration-angular", "integration-next", "integration-ssr"],
