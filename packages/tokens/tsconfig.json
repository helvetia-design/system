{
  "compilerOptions": {
    "target": "ES2020",

    "module": "ES2022",
    "moduleResolution": "bundler",

    "outDir": "dist/out-tsc",
    "declaration": true,
    "rootDir": "src",

    "strict": true,
    "noImplicitAny": false,

    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src"]
}
