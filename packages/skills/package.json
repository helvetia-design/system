{
  "name": "@helvetia-design/skills",
  "version": "0.0.0",
  "description": "Installer CLI that copies Claude Code skills for migrating from the Baloise Design System to the Helvetia Design System.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helvetia-design/system.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://helvetia-design.vercel.app",
  "security": "https://github.com/helvetia-design/system/security/advisories/new",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "skills": "dist/cli.js"
  },
  "files": [
    "dist/",
    "skills/"
  ],
  "scripts": {
    "build": "swc src/cli.ts -o dist/cli.js --config-file .swcrc",
    "test": "vitest --run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "eslint": "catalog:",
    "vitest": "catalog:"
  }
}
