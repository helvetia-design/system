{
  "jsc": {
    "target": "es5",
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "decoratorMetadata": true,
      "legacyDecorator": true
    },
    "keepClassNames": true,
    "externalHelpers": true,
    "loose": true
  },
  "module": {
    "type": "commonjs"
  },
  "sourceMaps": false,
  "exclude": [".*\\.spec.tsx?$", ".*\\.test.tsx?$", ".*.js$"]
}
