{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["scripts/**"],
  "globalEnv": [
    "DS_DOCUMENTATION",
    "DS_RELEASE",
    "DS_DEVELOPMENT",
    "DS_PLAYWRIGHT_TESTING",
    "TOKY_GITHUB_TOKEN",
    "TOKY_GITHUB_ORG_TOKEN",
    "TOKY_GITHUB_REF",
    "AUTH_GITHUB_ID",
    "AUTH_GITHUB_SECRET",
    "AUTH_SECRET",
    "FIGMA_API_TOKEN",
    "FIGMA_FILE_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "optimize"],
      "inputs": [
        "src/**",
        "app/**",
        "tokens/**",
        "config/**",
        "scripts/**",
        "stencil.config.ts",
        "tsconfig*.json",
        "ng-package.json",
        "!**/*.spec.*",
        "!**/*.play.*"
      ],
      "outputs": [
        "dist/**",
        "www/**",
        "docs/**",
        "components/**",
        "loader/**",
        "hydrate/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "app/**", "test/**"],
      "outputs": []
    },
    "lint": {
      "inputs": ["src/**", "app/**", "eslint.config.*"],
      "outputs": []
    },
    "optimize": {
      "inputs": ["src/**/svg/*.svg"],
      "outputs": ["src/**/svg.ts", "src/**/svg.json"]
    }
  }
}
